# from authority.md
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cams: <https://example.com/cams/vocabulary#> .

cams:MissionCommanderShape
    a sh:NodeShape ;
    sh:targetClass cams:MissionCommander ;
    dash:readOnly true ;
    sh:property [
        sh:path cams:name ;
        sh:name "Name" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path cams:expresses ;
        sh:name "Expresses Intent" ;
        sh:class cams:Intent ;
        dash:readOnly true ;
        sh:order 2 ;
    ] ;
    .

# from authority.md
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cams: <https://example.com/cams/vocabulary#> .

cams:IntentShape
    a sh:NodeShape ;
    sh:targetClass cams:Intent ;
    sh:property [
        sh:path cams:name ;
        sh:name "Name" ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path cams:priority ;
        sh:name "Priority" ;
        sh:datatype xsd:string ;
        sh:in ( "Low" "Medium" "High" ) ;
        sh:maxCount 1 ;
        sh:order 2 ;
    ] ;
    sh:property [
        sh:path cams:isGatedBy ;
        sh:name "Spawn gate (Constraint)" ;
        sh:class cams:Constraint ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Intent must have exactly one Constraint." ;
        sh:order 3 ;
    ] ;
    sh:property [
        sh:path cams:spawns ;
        sh:name "Spawns Objective" ;
        sh:class cams:Objective ;
        sh:order 4 ;
    ] ;
    sh:property [
        sh:path cams:activationStatus ;
        sh:name "Activation" ;
        sh:datatype xsd:string ;
        dash:readOnly true ;
        sh:maxCount 1 ;
        sh:order 5 ;
    ] ;
    .

